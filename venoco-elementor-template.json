                "html": "<nav style='display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;padding:0'>\n  <a href='#' style='flex-shrink:0'>\n    <img src='http://venoco.com/wp-content/uploads/2026/09/logo-venoco.png' alt='Venoco' style='height:64px;width:auto' onerror=\"this.style.display='none';this.nextElementSibling.style.display='block'\">\n    <svg style='display:none;height:64px;width:auto' viewBox='0 0 220 220' xmlns='http://www.w3.org/2000/svg'>\n      <ellipse cx='110' cy='110' rx='100' ry='80' fill='#ffed00'/>\n      <path d='M20 70 Q60 10 145 45 Q175 58 200 80 Q165 30 110 28 Q60 26 20 70Z' fill='#0033a0'/>\n      <path d='M200 150 Q160 210 75 175 Q45 162 20 140 Q55 190 110 192 Q160 194 200 150Z' fill='#0033a0'/>\n      <text x='110' y='122' text-anchor='middle' font-family='Arial,sans-serif' font-weight='900' font-style='italic' font-size='46' fill='white' stroke='white' stroke-width='3' paint-order='stroke'>venoco</text>\n      <text x='110' y='122' text-anchor='middle' font-family='Arial,sans-serif' font-weight='900' font-style='italic' font-size='46' fill='#0033a0'>venoco</text>\n    </svg>\n  </a>\n  <ul style='display:flex;align-items:center;gap:24px;list-style:none;margin:0;padding:0;flex-wrap:wrap'>\n    <li><a href='#quienes' style='font-family:Barlow,Arial,sans-serif;font-weight:600;font-size:15px;color:#1a1a1a;text-decoration:none;white-space:nowrap'>Quiénes somos</a></li>\n    <li><a href='#productos' style='font-family:Barlow,Arial,sans-serif;font-weight:600;font-size:15px;color:#1a1a1a;text-decoration:none;white-space:nowrap'>Productos</a></li>\n    <li><a href='#faq' style='font-family:Barlow,Arial,sans-serif;font-weight:600;font-size:15px;color:#1a1a1a;text-decoration:none;white-space:nowrap'>FAQ</a></li>\n    <li><a href='#contacto' style='font-family:Barlow,Arial,sans-serif;font-weight:600;font-size:15px;color:#1a1a1a;text-decoration:none;white-space:nowrap'>Contacto</a></li>\n    <li><a href='#contacto' style='display:inline-flex;align-items:center;padding:10px 22px;background:#0033a0;color:#fff;border-radius:8px;font-family:Barlow,Arial,sans-serif;font-weight:700;font-size:14px;text-decoration:none;white-space:nowrap'>Distribuidor</a></li>\n  </ul>\n</nav>"
