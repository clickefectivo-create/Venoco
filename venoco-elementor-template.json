              "id": "615f855b",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<div style='text-align:center;padding:80px 20px'>\n  <p style='font-family:Barlow,Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:2.5px;color:#ffed00;text-transform:uppercase;margin-bottom:16px'>EDICIÓN ESPECIAL</p>\n  <h2 style='font-family:Barlow,\"Arial Black\",Arial,sans-serif;font-size:clamp(30px,5vw,58px);font-weight:900;font-style:italic;line-height:1.05;color:#fff;margin-bottom:20px;text-wrap:balance'>66 Aniversario<br>Venoco</h2>\n  <p style='font-family:Barlow,Arial,sans-serif;font-size:18px;color:rgba(255,255,255,.85);max-width:500px;margin:0 auto 32px'>Seis décadas de compromiso con los motores de Venezuela. Descubre la línea conmemorativa.</p>\n  <a href='#productos' style='display:inline-flex;align-items:center;padding:14px 32px;background:#ffed00;color:#1a1a1a;border-radius:8px;font-family:Barlow,Arial,sans-serif;font-weight:700;font-size:16px;text-decoration:none'>Ver colección</a>\n</div>"
