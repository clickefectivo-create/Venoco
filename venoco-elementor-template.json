            {
              "id": "97c345f4",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<link href='https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&display=swap' rel='stylesheet'>\n<style>\n#vnk{font-family:Barlow,Arial,sans-serif;color:#1a1a1a}\n.vnk-h2{font-size:clamp(22px,3vw,32px);font-weight:700;color:#0033a0;text-align:center;margin-bottom:8px}\n.vnk-sub{text-align:center;color:#5c5c5c;margin-bottom:28px;font-size:16px}\n.vnk-tabs{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-bottom:24px}\n.vnk-tab{padding:8px 18px;background:#f0f4ff;border:2px solid transparent;border-radius:20px;cursor:pointer;font-weight:600;font-size:13px;color:#0033a0;transition:.2s;font-family:Barlow,Arial,sans-serif}\n.vnk-tab.active,.vnk-tab:hover{background:#0033a0;color:#fff}\n.vnk-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:16px}\n.vnk-card{background:#fff;border-radius:12px;padding:16px;box-shadow:0 2px 8px rgba(0,51,160,.1);cursor:pointer;transition:.2s;border:2px solid transparent}\n.vnk-card:hover{transform:translateY(-4px);box-shadow:0 8px 20px rgba(0,51,160,.18);border-color:#0033a0}\n.vnk-card img{width:100%;height:160px;object-fit:contain;margin-bottom:10px;background:#f7f7f7;border-radius:6px}\n.vnk-card h3{font-size:14px;font-weight:700;color:#0033a0;margin-bottom:4px;line-height:1.3}\n.vnk-card p{font-size:12px;color:#5c5c5c;line-height:1.4;margin-bottom:8px}\n.vnk-badges{display:flex;gap:4px;flex-wrap:wrap}\n.vnk-badge{background:#f0f4ff;color:#0033a0;padding:2px 7px;border-radius:10px;font-size:11px;font-weight:600}\n.vnk-modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:99999;align-items:center;justify-content:center;padding:16px}\n.vnk-modal-bg.open{display:flex}\n.vnk-modal{background:#fff;border-radius:16px;max-width:560px;width:100%;max-height:90vh;overflow-y:auto;padding:28px;position:relative}\n.vnk-modal-close{position:absolute;top:12px;right:16px;font-size:22px;cursor:pointer;background:none;border:none;color:#5c5c5c;line-height:1}\n.vnk-modal img{width:100%;max-height:200px;object-fit:contain;background:#f7f7f7;border-radius:8px;margin-bottom:14px}\n.vnk-modal h2{color:#0033a0;font-size:20px;font-weight:700;margin-bottom:10px}\n.vnk-modal ul{padding-left:18px;margin-top:10px}\n.vnk-modal ul li{margin-bottom:6px;font-size:14px;color:#1a1a1a}\n.vnk-btn{display:inline-flex;align-items:center;gap:6px;padding:10px 22px;background:#0033a0;color:#fff;border:none;border-radius:8px;font-weight:700;font-size:14px;cursor:pointer;margin-top:16px;font-family:Barlow,Arial,sans-serif;text-decoration:none}\n.vnk-btn:hover{background:#00267a}\n@media(max-width:520px){.vnk-grid{grid-template-columns:1fr 1fr}}\n@media(max-width:360px){.vnk-grid{grid-template-columns:1fr}}\n</style>\n<div id='vnk'>\n  <h2 class='vnk-h2'>Catálogo de Productos</h2>\n  <p class='vnk-sub'>17 referencias · 6 categorías · Calidad certificada API / JASO / ASTM</p>\n  <div class='vnk-tabs' id='vTabs'></div>\n  <div class='vnk-grid' id='vGrid'></div>\n</div>\n<div class='vnk-modal-bg' id='vModal'>\n  <div class='vnk-modal'>\n    <button class='vnk-modal-close' onclick='document.getElementById(\"vModal\").classList.remove(\"open\")'>&#x2715;</button>\n    <div id='vModalBody'></div>\n  </div>\n</div>\n<script>\nvar PROD=[\n  {cat:'Expert Plus',sku:'Expert Plus SN 20W-50',uso:'Lubricante mineral multigrado de alto desempeño para motores a gasolina, GLP y GNV.',specs:['SAE 20W-50','API SN'],pres:['1 L'],bullets:['Reduce consumo de aceite y mantiene la compresión.','Rápida lubricación en el encendido.','Elevada resistencia a la oxidación.'],img:'http://venoco.com/wp-content/uploads/2026/09/1L_EXPERT_PLUS_SN_20W-50.jpg'},\n  {cat:'Expert Extra',sku:'Expert Extra SP 10W-30',uso:'Lubricante semisintético para motores a gasolina, GLP y GNV bajo especificación API SP.',specs:['SAE 10W-30','API SP'],pres:['1 L'],bullets:['Menor degradación y mayor estabilidad térmica.','Mínima formación de depósitos.','Rápida lubricación en arranque en frío.'],img:'http://venoco.com/wp-content/uploads/2026/09/1L_EXPERT-EXTRA-SP-10W-30.jpg'},\n  {cat:'Expert Extra',sku:'Expert Extra SP 20W-50',uso:'Lubricante semisintético de alta viscosidad para condiciones severas de operación.',specs:['SAE 20W-50','API SP'],pres:['1 L'],bullets:['Alta estabilidad térmica.','Reducida formación de depósitos y lodos.','Película lubricante resistente.'],img:'http://venoco.com/wp-content/uploads/2026/09/1L_EXPERT-EXTRAS-SP-20W-50.jpg'},\n  {cat:'Expert Extra',sku:'Expert Extra SP 15W-40',uso:'Lubricante semisintético para motores a gasolina con máxima protección API SP.',specs:['SAE 15W-40','API SP'],pres:['1 L'],bullets:['Protección avanzada contra LSPI.','Minimiza desgaste de componentes internos.','Optimiza el rendimiento del combustible.'],img:'http://venoco.com/wp-content/uploads/2026/09/1L_EXPERT-EXTRA-SP-15W-40.jpg'},\n  {cat:'Expert Extra Plus',sku:'Expert Extra Plus SP 0W-20',uso:'Lubricante 100% sintético de ultra baja viscosidad para motores modernos de alta eficiencia.',specs:['SAE 0W-20','API SP'],pres:['1 L'],bullets:['Fluidez inmediata en el arranque.','Optimiza el ahorro de combustible.','Control de depósitos y LSPI.'],img:'http://venoco.com/wp-content/uploads/2026/09/1L_EXPERT_EXTRA_PLUS_SN_0W-20.jpg'},\n  {cat:'Expert Extra Plus',sku:'Expert Extra Plus SP 5W-20',uso:'Lubricante 100% sintético para motores a gasolina con máxima fluidez y economía energética.',specs:['SAE 5W-20','API SP'],pres:['1 L'],bullets:['Protección inmediata desde el encendido.','Excepcional estabilidad térmica.','Mantiene el motor limpio.'],img:'http://venoco.com/wp-content/uploads/2026/09/1L_EXPERT_EXTRA_PLUS_SN_5W-20.jpg'},\n  {cat:'Expert Extra Plus',sku:'Expert Extra Plus SP 5W-30',uso:'Lubricante 100% sintético para motores modernos con turbocargador e inyección directa.',specs:['SAE 5W-30','API SP'],pres:['1 L'],bullets:['Fluye en menos de 3 segundos.','Control de depósitos y barnices.','Protección contra LSPI.'],img:'http://venoco.com/wp-content/uploads/2026/09/1L_EXPERT_EXTRA_PLUS_SN_5W-30-1.png'},\n  {cat:'Expert Extra Plus',sku:'Expert Extra Plus SP 10W-30',uso:'Lubricante 100% sintético para máxima protección de motores a gasolina de última generación.',specs:['SAE 10W-30','API SP'],pres:['1 L'],bullets:['Menor degradación y mayor intervalo entre cambios.','Película lubricante estable.','Protección contra desgaste y corrosión.'],img:'http://venoco.com/wp-content/uploads/2026/09/1L_EXPERT_EXTRA_PLUS_SN_10W-30.jpg'},\n  {cat:'Expert Extra Plus',sku:'Expert Extra Plus SP 10W-40',uso:'Lubricante 100% sintético para motores a gasolina en condiciones de operación severas.',specs:['SAE 10W-40','API SP'],pres:['1 L'],bullets:['Película estable a altas temperaturas.','Protección contra desgaste y corrosión.','Control de depósitos en motores modernos.'],img:'http://venoco.com/wp-content/uploads/2026/09/1L_EXPERT_EXTRA_PLUS_SN_10W-40.jpg'},\n  {cat:'Expert Power 4T',sku:'Expert Power 4T SL 20W-50 JASO MA-2',uso:'Lubricante multigrado para motocicletas de 4 tiempos con aditivos de última tecnología.',specs:['SAE 20W-50','API SL','JASO MA-2'],pres:['1 L'],bullets:['Óptima transferencia de potencia.','Excelente estabilidad térmica.','Máxima capacidad antidesgaste.'],img:'http://venoco.com/wp-content/uploads/2026/09/1L_EXPERT_POWER_4T_SN_20W-50.jpg'},\n  {cat:'Venoco 2T',sku:'Venoco 2T Aire API TC JASO FB',uso:'Lubricante para motores de motocicletas de 2 tiempos enfriados por aire.',specs:['API TC','JASO FB'],pres:['1 L'],bullets:['Minimiza depósitos en cámara y bujías.','Evita la preignición.','Se diluye fácilmente con gasolina.'],img:'http://venoco.com/wp-content/uploads/2026/09/1L_2T_Aire_API_TC.jpg'},\n  {cat:'Venoco 2T',sku:'Venoco 2T Agua TC-W3',uso:'Lubricante para motores fuera de borda de 2 tiempos enfriados por agua.',specs:['TC-W3'],pres:['1 L'],bullets:['Para motores fuera de borda y aplicaciones acuáticas.','Minimiza depósitos en cámara y bujías.','Excelente miscibilidad con gasolina.'],img:'http://venoco.com/wp-content/uploads/2026/09/1L_2T_Agua_TC-W3.jpg'},\n  {cat:'Transmisión',sku:'Venoco ATF D-III (auto)',uso:'Fluido para transmisiones automáticas Dexron III / Mercon.',specs:['ATF','Dexron III','Mercon'],pres:['1 L'],bullets:['Gran estabilidad a la oxidación.','Aditivos antidesgaste y anticorrosivos.','Compatible con sellos del sistema.'],img:'http://venoco.com/wp-content/uploads/2026/09/1L_ATF_D-III.jpg'},\n  {cat:'Transmisión',sku:'Venoco GL-5 80W-90 (manual)',uso:'Aceite de extrema presión para engranajes y transmisiones manuales API GL-5.',specs:['SAE 80W-90','API GL-5'],pres:['1 L'],bullets:['Soporta torques extremos.','Excelente estabilidad contra la oxidación.','Propiedades antiherrumbre y anticorrosivas.'],img:'http://venoco.com/wp-content/uploads/2026/09/1L_GL-5_80W-90.jpg'},\n  {cat:'Transmisión',sku:'Venoco GL-5 85W-140 (manual)',uso:'Aceite de extrema presión para transmisiones manuales de trabajo pesado API GL-5.',specs:['SAE 85W-140','API GL-5'],pres:['1 L'],bullets:['Soporta cargas extremas.','Alta estabilidad térmica.','Protección integral contra desgaste.'],img:'http://venoco.com/wp-content/uploads/2026/09/1L_GL-5_85W-140.jpg'},\n  {cat:'Especialidades',sku:'Refrigerante Verde',uso:'Fluido refrigerante y anticongelante listo para usar.',specs:['Listo para usar'],pres:['Galón'],bullets:['Excelente transferencia térmica.','Previene sarro y óxido.','Seguro para mangueras y radiadores de aluminio.'],img:'http://venoco.com/wp-content/uploads/2026/09/Galon_Refrigerante_Verde.jpg'},\n  {cat:'Especialidades',sku:'Refrigerante Rojo',uso:'Fluido refrigerante de tecnología orgánica / larga duración (OAT/HOAT).',specs:['Larga duración'],pres:['Galón'],bullets:['Protección prolongada contra corrosión.','Excelente estabilidad térmica.','Inerte ante elastómeros y metales.'],img:'http://venoco.com/wp-content/uploads/2026/09/Galon_Refrigerante_Rojo.jpg'}\n];\nvar cats=[],cur='';\nPROD.forEach(function(p){if(cats.indexOf(p.cat)<0)cats.push(p.cat);});\ncur=cats[0];\nfunction renderTabs(){\n  document.getElementById('vTabs').innerHTML=cats.map(function(c){\n    return '<button class=\"vnk-tab'+(c===cur?' active':'')+'\" onclick=\"setCat(\\''+c.replace(/\\'/g,'\\\\\\'')+'\\')\">'+(c.replace('Expert ','').replace('Venoco ','').replace('Especialidades','Especialidades'))+'</button>';\n  }).join('');\n}\nfunction renderGrid(){\n  document.getElementById('vGrid').innerHTML=PROD.filter(function(p){return p.cat===cur;}).map(function(p){\n    var i=PROD.indexOf(p);\n    return '<div class=\"vnk-card\" onclick=\"openModal('+i+')\">'\n      +'<img src=\"'+p.img+'\" alt=\"'+p.sku+'\" loading=\"lazy\">'\n      +'<h3>'+p.sku+'</h3>'\n      +'<p>'+p.uso.substring(0,80)+'...</p>'\n      +'<div class=\"vnk-badges\">'+p.specs.map(function(s){return '<span class=\"vnk-badge\">'+s+'</span>';}).join('')+'</div>'\n      +'</div>';\n  }).join('');\n}\nfunction setCat(c){cur=c;renderTabs();renderGrid();}\nfunction openModal(i){\n  var p=PROD[i];\n  document.getElementById('vModalBody').innerHTML=\n    '<img src=\"'+p.img+'\" alt=\"'+p.sku+'\">'\n    +'<h2>'+p.sku+'</h2>'\n    +'<div class=\"vnk-badges\" style=\"margin-bottom:10px\">'+p.specs.map(function(s){return '<span class=\"vnk-badge\">'+s+'</span>';}).join('')+'</div>'\n    +'<p style=\"color:#5c5c5c;font-size:14px;margin-bottom:8px\">'+p.uso+'</p>'\n    +'<ul>'+p.bullets.map(function(b){return '<li>'+b+'</li>';}).join('')+'</ul>'\n    +'<a href=\"mailto:ventas@venoco.com\" class=\"vnk-btn\">Solicitar información</a>';\n  document.getElementById('vModal').classList.add('open');\n}\ndocument.getElementById('vModal').addEventListener('click',function(e){if(e.target===this)this.classList.remove('open');});\nrenderTabs();renderGrid();\n</script>"
              },
              "elements": []
            }
          ]
        }
      ]
    },
