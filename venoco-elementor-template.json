                "html": "<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:60px 0'>\n  <div style='background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);border-radius:12px;padding:24px;text-align:center;backdrop-filter:blur(4px)'>\n    <div style='font-family:Barlow,Arial,sans-serif;font-size:42px;font-weight:900;color:#ffed00;line-height:1'>66</div>\n    <div style='font-family:Barlow,Arial,sans-serif;font-size:13px;color:rgba(255,255,255,.8);margin-top:4px'>Años de experiencia</div>\n  </div>\n  <div style='background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);border-radius:12px;padding:24px;text-align:center;backdrop-filter:blur(4px)'>\n    <div style='font-family:Barlow,Arial,sans-serif;font-size:42px;font-weight:900;color:#ffed00;line-height:1'>17</div>\n    <div style='font-family:Barlow,Arial,sans-serif;font-size:13px;color:rgba(255,255,255,.8);margin-top:4px'>Referencias activas</div>\n  </div>\n  <div style='background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);border-radius:12px;padding:24px;text-align:center;backdrop-filter:blur(4px)'>\n    <div style='font-family:Barlow,Arial,sans-serif;font-size:42px;font-weight:900;color:#ffed00;line-height:1'>6</div>\n    <div style='font-family:Barlow,Arial,sans-serif;font-size:13px;color:rgba(255,255,255,.8);margin-top:4px'>Categorías de producto</div>\n  </div>\n  <div style='background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.2);border-radius:12px;padding:24px;text-align:center;backdrop-filter:blur(4px)'>\n    <div style='font-family:Barlow,Arial,sans-serif;font-size:42px;font-weight:900;color:#ffed00;line-height:1'>API</div>\n    <div style='font-family:Barlow,Arial,sans-serif;font-size:13px;color:rgba(255,255,255,.8);margin-top:4px'>Calidad certificada</div>\n  </div>\n</div>"
