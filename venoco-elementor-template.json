                "html": "<div style='background:rgba(255,255,255,.1);border-radius:16px;padding:32px;backdrop-filter:blur(8px);margin:60px 0'>\n  <h3 style='font-family:Barlow,Arial,sans-serif;font-size:20px;font-weight:700;color:#fff;margin-bottom:20px'>Envíanos un mensaje</h3>\n  <form action='mailto:ventas@venoco.com' method='post' enctype='text/plain' style='display:flex;flex-direction:column;gap:14px'>\n    <div>\n      <label style='font-family:Barlow,Arial,sans-serif;font-size:13px;font-weight:600;color:rgba(255,255,255,.8);display:block;margin-bottom:6px'>Nombre completo</label>\n      <input type='text' name='nombre' required placeholder='Tu nombre' style='width:100%;padding:11px 14px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);border-radius:8px;color:#fff;font-family:Barlow,Arial,sans-serif;font-size:15px'>\n    </div>\n    <div>\n      <label style='font-family:Barlow,Arial,sans-serif;font-size:13px;font-weight:600;color:rgba(255,255,255,.8);display:block;margin-bottom:6px'>Correo electrónico</label>\n      <input type='email' name='correo' required placeholder='tu@correo.com' style='width:100%;padding:11px 14px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);border-radius:8px;color:#fff;font-family:Barlow,Arial,sans-serif;font-size:15px'>\n    </div>\n    <div>\n      <label style='font-family:Barlow,Arial,sans-serif;font-size:13px;font-weight:600;color:rgba(255,255,255,.8);display:block;margin-bottom:6px'>¿En qué podemos ayudarte?</label>\n      <textarea name='mensaje' rows='4' required placeholder='Cuéntanos sobre tu vehículo y qué producto buscas...' style='width:100%;padding:11px 14px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);border-radius:8px;color:#fff;font-family:Barlow,Arial,sans-serif;font-size:15px;resize:vertical'></textarea>\n    </div>\n    <button type='submit' style='padding:13px 28px;background:#ffed00;color:#1a1a1a;border:none;border-radius:8px;font-family:Barlow,Arial,sans-serif;font-weight:700;font-size:15px;cursor:pointer;align-self:flex-start'>Enviar mensaje</button>\n  </form>\n  <p style='font-family:Barlow,Arial,sans-serif;font-size:12px;color:rgba(255,255,255,.5);margin-top:16px'>También puedes usar el plugin Contact Form 7 en WordPress para un formulario con seguimiento completo.</p>\n</div>"
